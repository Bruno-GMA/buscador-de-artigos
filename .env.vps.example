# Copie para .env.vps na VPS. DNS de APP_DOMAIN deve apontar para o IP da VPS.
APP_DOMAIN=academic.example.com
DASHBOARD_URL=https://academic.example.com
# Gere com: docker run --rm -it caddy:2-alpine caddy hash-password
# Use aspas simples para preservar os caracteres $ do hash.
DASHBOARD_PASSWORD_HASH='$2a$14$SUBSTITUA_PELO_HASH_GERADO'
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
TRIGGER_API_KEY=SUBSTITUA_POR_CHAVE_FORTE
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=America/Maceio
MAX_PAPERS_PER_RUN=12
IEEE_API_KEY=
IEEE_AI_PERMISSION_GRANTED=false
CAPES_IMPORT_DIR=/app/imports/capes
CAPES_RSS_URLS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

