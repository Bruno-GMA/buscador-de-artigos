# Copie para .env na raiz. Não publique credenciais.
DATABASE_URL=sqlite:////app/data/academic_pulse.db
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=America/Maceio
MAX_PAPERS_PER_RUN=9
IEEE_API_KEY=
IEEE_AI_PERMISSION_GRANTED=false
DASHBOARD_URL=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Defina um token forte antes de expor a API fora do computador local.
TRIGGER_API_KEY=

